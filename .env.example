# Required for studio features (sign up, artworks, publish exhibitions).
# /show/demo and /studio/demo work without these; sample data is bundled in the app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo-only navigation (no sign-up in the header) is the default.
# Set to "false" when developing or hosting the full studio with Supabase.
# VITE_PUBLIC_DEMO_ONLY=false
